{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Set key_mode param.","type":"text"},{"type":"text","text":"\n"},{"type":"text","text":"设置key_mode 参数."}],"kind":"symbol","metadata":{"extendedModule":"RFIDManager","title":"setKeyMode(_:)","externalID":"c:@CM@RFIDManager@objc(cs)RFIDBleManager(im)setKeyMode:","role":"symbol","modules":[{"name":"RFIDManager"}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"setKeyMode","kind":"identifier"},{"kind":"text","text":"("},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"c:@M@RFIDManager@objc(cs)RFIDResult","text":"RFIDResult","kind":"typeIdentifier"}],"symbolKind":"method","roleHeading":"Instance Method"},"hierarchy":{"paths":[["doc:\/\/com.rfid.RFIDManager\/documentation\/RFIDManager","doc:\/\/com.rfid.RFIDManager\/documentation\/RFIDManager\/RFIDBleManager"]]},"identifier":{"url":"doc:\/\/com.rfid.RFIDManager\/documentation\/RFIDManager\/RFIDBleManager\/setKeyMode(_:)","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"setKeyMode","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"keyMode","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"c:@M@RFIDManager@objc(cs)RFIDResult","identifier":"doc:\/\/com.rfid.RFIDManager\/documentation\/RFIDManager\/RFIDResult","text":"RFIDResult","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"0 or 1."},{"type":"text","text":"\n"},{"type":"text","text":"0: Only lift keycode 1"}],"type":"paragraph"}],"name":"keyMode"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"