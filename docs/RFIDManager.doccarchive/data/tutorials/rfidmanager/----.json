xt":"标签数据回调也可以通过开启盘点方法中的 tagInfoListBlock 参数设置，效果与步骤一相同"}]}],"type":"step","code":"inventory-tags-02.swift"},{"type":"step","caption":[{"inlineContent":[{"text":"例如，过滤 EPC 以 ","type":"text"},{"type":"strong","inlineContent":[{"text":"1111222233334444","type":"text"}]},{"type":"text","text":" 为开头的标签，并且每张标签只上报一次"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"开启盘点函数时，可以通过传入 filter 和 inventoryParam 参数来实现一些特殊功能"}],"type":"paragraph"}],"media":null,"code":"inventory-tags-03.swift","runtimePreview":null},{"type":"step","caption":[],"content":[{"type":"paragraph","inlineContent":[{"text":"需要停止盘点时，调用停止盘点方法","type":"text"}]}],"media":null,"code":"inventory-tags-04.swift","runtimePreview":null},{"type":"step","caption":[{"inlineContent":[{"text":"例如，设置功率为 20，设置链路参数为 Gen2X_Miller8_160KHz，设置盘点的标签数据区域为 EPC+TID","type":"text"}],"type":"paragraph"}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"可以根据需求修改一些模块的配置。需要注意，盘点过程中不能修改 RFID 模块的配置。"}]}],"media":null,"code":"inventory-tags-05.swift","runtimePreview":null}],"anchor":"盘点-RFID-标签"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/rfidmanager\/----"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/----"},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"connect-device-05.swift":{"fileName":"ViewController.swift","syntax":"swift","highlights":[{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"fileType":"swift","type":"file","identifier":"connect-device-05.swift","content":["import CoreBluetooth","import RFIDManager","import UIKit","","class ViewController: UIViewController {","    var discoveredDevices: [CBPeripheral] = []","","    override func viewDidLoad() {","        super.viewDidLoad()","","        RFIDBleManager.shared.setConnectStateUpdateBlock { peripheral, state in","            print(\"Device: \\(peripheral.name ?? \"Unknown\"), State: \\(state)\")","        }","    }","","    func startScanning() {","        \/\/ Start scanning for Bluetooth devices","        \/\/ 开始扫描蓝牙设备","        RFIDBleManager.shared.scanForPeripherals { peripheral, advertisementData, RSSI in","            print(\"scanForPeripherals: \\(String(describing: peripheral.name))  \\(advertisementData.description)\")","","            \/\/ Filter by manufacturer data (requires BLE firmware 2.08+)","            \/\/ The prefix of kCBAdvDataManufacturerData is 0x4720","            \/\/ 通过厂家信息过滤设备（需要蓝牙固件 2.08+）","            \/\/ kCBAdvDataManufacturerData 前缀为 0x4720","            if let data = advertisementData[\"kCBAdvDataManufacturerData\"] as? Data,","               data.count >= 2 && data[0] == 0x47 && data[1] == 0x20","            {","                print(\"kCBAdvDataManufacturerData: \\(data)\")","            } else {","                \/\/ return  \/\/ Uncomment to filter out non-matching devices","                \/\/         \/\/ 取消注释以过滤不匹配的设备","            }","","            if !self.discoveredDevices.contains(where: { $0.name == peripheral.name }) {","                self.discoveredDevices.append(peripheral)","            }","        }","    }","","    func stopScanning() {","        \/\/ Stop scanning for peripherals","        \/\/ 停止扫描外设","        RFIDBleManager.shared.stopForPeripherals()","    }","","    func connectToDevice(_ peripheral: CBPeripheral) {","        RFIDBleManager.shared.connectPeripheral(","            peripheral: peripheral,","            didConnectBlock: { connectedPeripheral in","                print(\"Successfully connected: \\(connectedPeripheral.name ?? \"Unknown\")\")","            },","            didFailToConnectBlock: { failedPeripheral, error in","                print(\"Connection failed: \\(failedPeripheral.name ?? \"Unknown\") \" ","                    + \"Error: \\(error?.localizedDescription ?? \"Unknown error\")\"","                )","            }","        )","    }","}"]},"inventory-tags-05.swift":{"fileName":"InventoryManager.swift","syntax":"swift","highlights":[{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40}],"fileType":"swift","type":"file","identifier":"inventory-tags-05.swift","content":["import Foundation","import RFIDManager","","class InventoryManager {","    func initInventory() {","        let res = RFIDBleManager.shared.initialize()","        print(\"initialize \\(res.code == .success ? \"success\" : \"failure\")\")","","        \/\/ Set tag data callback","        \/\/ 设置标签数据回调","        RFIDBleManager.shared.setTagInfoListBlock { tagList in","            print(\"Received \\(tagList.count) tags\")","            \/\/ Process tag data in callback","            \/\/ 可在回调中处理标签数据","            for tag in tagList {","                print(\"EPC: \\(tag.description)\")","            }","        }","    }","","    func startInventory() {","        let result = RFIDBleManager.shared.startInventory(filter: nil)","        print(result.code == .success ? \"Inventory started\" : \"\\(result.message ?? \"startInventory failed\")\")","    }","","    func stopInventory() {","        let result = RFIDBleManager.shared.stopInventory()","        print(result.code == .success ? \"Inventory stopped\" : \"\\(result.message ?? \"stopInventory failed\")\")","    }","","    func setConfig() {","        var res = RFIDBleManager.shared.setPower(20)","        print(res.code == .success ? \"setPower success\" : \"\\(res.message ?? \"setPower failed\")\")","","        res = RFIDBleManager.shared.setRFLink(RFIDRFLink.Gen2X_Miller8_160KHz.rawValue)","        print(res.code == .success ? \"setRFLinkMode success\" : \"\\(res.message ?? \"setRFLinkMode failed\")\")","","        res = RFIDBleManager.shared.setMemoryBank(RFIDMemoryBank(bank: RFIDMemoryBank.InventoryBank.EPC_TID.rawValue))","        print(res.code == .success ? \"setMemoryBank success\" : \"\\(res.message ?? \"setMemoryBank failed\")\")","    }","}"]},"doc://com.rfid.RFIDManager/tutorials/--RFIDManager/---RFIDManager":{"title":"导入 RFIDManager","abstract":[],"kind":"article","type":"topic","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/--RFIDManager\/---RFIDManager","role":"article","url":"\/tutorials\/--rfidmanager\/---rfidmanager"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/--RFIDManager":{"title":"导入 RFIDManager 到项目","abstract":[{"text":"本教程介绍将 RFIDManager 导入项目的两种方法：Swift Package Manager 和本地文件引入","type":"text"}],"kind":"project","estimatedTime":"10min","type":"topic","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/--RFIDManager","role":"project","url":"\/tutorials\/rfidmanager\/--rfidmanager"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/----#%E8%BF%9E%E6%8E%A5-RFID-%E8%93%9D%E7%89%99%E8%AE%BE%E5%A4%87":{"title":"连接 RFID 蓝牙设备","abstract":[{"text":"本教程将指导您完成 RFIDManager SDK 的基本使用，包括连接设备和盘点标签","type":"text"}],"kind":"section","type":"section","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/----#%E8%BF%9E%E6%8E%A5-RFID-%E8%93%9D%E7%89%99%E8%AE%BE%E5%A4%87","role":"pseudoSymbol","url":"\/tutorials\/rfidmanager\/----#%E8%BF%9E%E6%8E%A5-RFID-%E8%93%9D%E7%89%99%E8%AE%BE%E5%A4%87"},"connect-device-03.swift":{"identifier":"connect-device-03.swift","fileType":"swift","highlights":[{"line":37},{"line":38},{"line":39},{"line":40},{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46},{"line":47},{"line":48},{"line":49},{"line":50}],"syntax":"swift","type":"file","fileName":"ViewController.swift","content":["import CoreBluetooth","import RFIDManager","import UIKit","","class ViewController: UIViewController {","    var discoveredDevices: [CBPeripheral] = []","","    override func viewDidLoad() {","        super.viewDidLoad()","    }","","    func startScanning() {","        \/\/ Start scanning for Bluetooth devices","        \/\/ 开始扫描蓝牙设备","        RFIDBleManager.shared.scanForPeripherals { peripheral, advertisementData, RSSI