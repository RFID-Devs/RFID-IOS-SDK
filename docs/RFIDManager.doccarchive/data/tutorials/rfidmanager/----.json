urn  \/\/ Uncomment to filter out non-matching devices","                \/\/         \/\/ 取消注释以过滤不匹配的设备","            }","","            if !self.discoveredDevices.contains(where: { $0.name == peripheral.name }) {","                self.discoveredDevices.append(peripheral)","            }","        }","    }","","    func connectToDevice(_ peripheral: CBPeripheral) {","        RFIDBleManager.shared.connectPeripheral(","            peripheral: peripheral,","            didConnectBlock: { connectedPeripheral in","                print(\"Successfully connected: \\(connectedPeripheral.name ?? \"Unknown\")\")","            },","            didFailToConnectBlock: { failedPeripheral, error in","                print(\"Connection failed: \\(failedPeripheral.name ?? \"Unknown\") \" ","                    + \"Error: \\(error?.localizedDescription ?? \"Unknown error\")\"","                )","            }","        )","    }","}"],"identifier":"connect-device-04.swift","syntax":"swift","highlights":[{"line":10},{"line":11},{"line":12},{"line":13}],"type":"file","fileType":"swift"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/----":{"url":"\/tutorials\/rfidmanager\/----","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/----","abstract":[{"type":"text","text":"本教程将指导您完成 RFIDManager SDK 的基本使用，包括连接设备和盘点标签"}],"title":"快速开始","estimatedTime":"20min","role":"project","type":"topic","kind":"project"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/--RFIDManager#SDK-%E6%9C%AC%E5%9C%B0%E6%96%87%E4%BB%B6%E5%BC%95%E5%85%A5":{"url":"\/tutorials\/rfidmanager\/--rfidmanager#SDK-%E6%9C%AC%E5%9C%B0%E6%96%87%E4%BB%B6%E5%BC%95%E5%85%A5","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/--RFIDManager#SDK-%E6%9C%AC%E5%9C%B0%E6%96%87%E4%BB%B6%E5%BC%95%E5%85%A5","abstract":[{"type":"text","text":"本教程介绍将 RFIDManager 导入项目的两种方法：Swift Package Manager 和本地文件引入"}],"title":"SDK 本地文件引入","role":"pseudoSymbol","type":"section","kind":"section"},"doc://com.rfid.RFIDM