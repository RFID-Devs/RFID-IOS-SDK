lineContent":[{"type":"text","text":"You can modify module configuration as needed. Note that RFID module configuration cannot be modified during inventory"}],"type":"paragraph"}],"code":"inventory-tags-05.swift","caption":[{"inlineContent":[{"text":"For example, set power to 20, set link parameter to Gen2X_Miller8_160KHz, set inventory data area to EPC+TID","type":"text"}],"type":"paragraph"}]}],"title":"Inventory RFID Tags","anchor":"Inventory-RFID-Tags"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"project","references":{"inventory-tags-01.swift":{"fileName":"InventoryManager.swift","content":["import Foundation","import RFIDManager","","class InventoryManager {","    func initInventory() {","        let res = RFIDBleManager.shared.initialize()","        print(\"initialize \\(res.code == .success ? \"success\" : \"failure\")\")","","        \/\/ Set tag data callback","        \/\/ 设置标签数据回调","        RFIDBleManager.shared.setTagInfoListBlock { tagList in","            print(\"Received \\(tagList.count) tags\")","            \/\/ Process tag data in callback","            \/\/ 可在回调中处理标签数据","            for tag in tagList {","                print(\"EPC: \\(tag.description)\")","            }","        }","    }","}"],"identifier":"inventory-tags-01.swift","syntax":"swift","highlights":[{"line":8},{"line":9},{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17},{"line":18}],"type":"file","fileType":"swift"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/Getting-Started#Inventory-RFID-Tags":{"url":"\/tutorials\/rfidmanager\/getting-started#Inventory-RFID-Tags","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/Getting-Started#Inventory-RFID-Tags","abstract":[{"text":"This tutorial will guide you through the basic usage of RFIDManager SDK, including connecting devices and inventorying tags","type":"text"}],"title":"Inventory RFID Tags","role":"pseudoSymbol","type":"section","kind":"section"},"doc://com.rfid.RFIDManager/tutorials/Meet-RFIDManager/Import-RFIDManager":{"abstract":[],"url":"\/tutorials\/meet-rfidmanager\/import-rfidmanager","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/Meet-RFIDManager\/Import-RFIDManager","kind":"article","title":"Import RFIDManager","role":"article","type":"topic"},"connect-device-05.swift":{"fileName":"ViewController.swift","fileType":"swift","identifier":"connect-device-05.swift","syntax":"swift","content":["import CoreBluetooth","import RFIDManager","import UIKit","","class ViewController: UIViewController {","    var discoveredDevices: [CBPeripheral] = []","","    override func viewDidLoad() {","        super.viewDidLoad()","","        RFIDBleManager.shared.setConnectStateUpdateBlock { peripheral, state in","            print(\"Device: \\(peripheral.name ?? \"Unknown\"), State: \\(state)\")","        }","    }","","    func startScanning() {","        \/\/ Start scanning for Bluetooth devices","        \/\/ 开始扫描蓝牙设备","        RFIDBleManager.shared.scanForPeripherals { peripheral, advertisementData, RSSI in","            print(\"scanForPeripherals: \\(String(describing: peripheral.name))  \\(advertisementData.description)\")","","            \/\/ Filter by manufacturer data (requires BLE firmware 2.08+)","            \/\/ The prefix of kCBAdvDataManufacturerData is 0x4720","            \/\/ 通过厂家信息过滤设备（需要蓝牙固件 2.08+）","            \/\/ kCBAdvDataManufacturerData 前缀为 0x4720","            if let data = advertisementData[\"kCBAdvDataManufacturerData\"] as? Data,","               data.count >= 2 && data[0] == 0x47 && data[1] == 0x20","            {","                print(\"kCBAdvDataManufacturerData: \\(data)\")","            } else {","                \/\/ return  \/\/ Uncomment to filter out non-matching devices","                \/\/         \/\/ 取消注释以过滤不匹配的设备","            }","","            if !self.discoveredDevices.contains(where: { $0.name == peripheral.name }) {","                self.discoveredDevices.append(peripheral)","            }","        }","    }","","    func stopScanning() {","        \/\/ Stop scanning for peripherals","        \/\/ 停止扫描外设","        RFIDBleManager.shared.stopForPeripherals()","    }","","    func connectToDevice(_ peripheral: CBPeripheral) {","        RFIDBleManager.shared.connectPeripheral(","            peripheral: peripheral,","            didConnectBlock: { connectedPeripheral in","                print(\"Successfully connected: \\(connectedPeripheral.name ?? \"Unknown\")\")","            },","            didFailToConnectBlock: { failedPeripheral, error in","                print(\"Connection failed: \\(failedPeripheral.name ?? \"Unknown\") \" ","                    + \"Error: \\(error?.localizedDescription ?? \"Unknown error\")\"","                )","            }","        )","    }","}"],"highlights":[{"line":41},{"line":42},{"line":43},{"line":44},{"line":45},{"line":46}],"type":"file"},"inventory-tags-02.swift":{"fileName":"InventoryManager.swift","fileType":"swift","identifier":"inventory-tags-02.swift","syntax":"swift","content":["import Foundation","import RFIDManager","","class InventoryManager {","    func initInventory() {","        let res = RFIDBleManager.shared.initialize()","        print(\"initialize \\(res.code == .success ? \"success\" : \"failure\")\")","","        \/\/ Set tag data callback","        \/\/ 设置标签数据回调","        RFIDBleManager.shared.setTagInfoListBlock { tagList in","            print(\"Received \\(tagList.count) tags\")","            \/\/ Process tag data in callback","            \/\/ 可在回调中处理标签数据","            for tag in tagList {","                print(\"EPC: \\(tag.description)\")","            }","        }","    }","","    func startInventory() {","        let result = RFIDBleManager.shared.startInventory(filter: nil)","        print(result.code == .success ? \"Inventory started\" : \"\\(result.message ?? \"startInventory failed\")\")","    }","}"],"highlights":[{"line":20},{"line":21},{"line":22},{"line":23},{"line":24}],"type":"file"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/Import-RFIDManager#Import-SDK-using-Swift-Package-Manager":{"abstract":[{"text":"This tutorial introduces two methods to import RFIDManager into your project: Swift Package Manager and local file import","type":"text"}],"url":"\/tutorials\/rfidmanager\/import-rfidmanager#Import-SDK-using-Swift-Package-Manager","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/Import-RFIDManager#Import-SDK-using-Swift-Package-Manager","kind":"section","title":"Import SDK using Swift Package Manager","role":"pseudoSymbol","type":"section"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/Import-RFIDManager":{"abstract":[{"text":"This tutorial introduces two methods to import RFIDManager into your project: Swift Package Manager and local file import","type":"text"}],"url":"\/tutorials\/rfidmanager\/import-rfidmanager","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/Import-RFIDManager","kind":"project","title":"Import RFIDManager to Project","estimatedTime":"10min","role":"project","type":"topic"},"connect-device-01.swift":{"fileName":"ViewController.swift","fileType":"swift","identifier":"connect-device-01.swift","syntax":"swift","content":["import RFIDManager","import UIKit","","class ViewController: UIViewController {","    override func viewDidLoad() {","        super.viewDidLoad()","","        \/\/ RFIDBleManager.shared is the singleton object of the SDK","        \/\/ RFIDBleManager.shared 是 SDK 的单例对象","        let manager = RFIDBleManager.shared","    }","}",""],"highlights":[],"type":"file"},"doc://com.rfid.RFIDManager/tutorials/Meet-RFIDManager/Getting-Started":{"abstract":[],"url":"\/tutorials\/meet-rfidmanager\/getting-started","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/Meet-RFIDManager\/Getting-Started","kind":"article","title":"Getting Started","role":"article","type":"topic"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/Getting-Started#Connect-Bluetooth-RFID-Device":{"abstract":[{"text":"This tutorial will guide you through the basic usage of RFIDManager SDK, including connecting devices and inventorying tags","type":"text"}],"url":"\/tutorials\/rfidmanager\/getting-started#Connect-Bluetooth-RFID-Device","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/Getting-Started#Connect-Bluetooth-RFID-Device","kind":"section","title":"Connect Bluetooth RFID Device","role":"pseudoSymbol","type":"section"},"connect-device-04.swift":{"fileName":"ViewController.swift","fileType":"swift","identifier":"connect-device-04.swift","syntax":"swift","content":["import CoreBluetooth","import RFIDManager","import UIKit","","class ViewController: UIViewController {","    var discoveredDevices: [CBPeripheral] = []","","    override func viewDidLoad() {","        super.viewDidLoad()","","        RFIDBleManager.shared.setConnectStateUpdateBlock { peripheral, state in","            print(\"Device: \\(peripheral.name ?? \"Unknown\"), State: \\(state)\")","        }","    }","","    func startScanning() {","        \/\/ Start scanning for Bluetooth devices","        \/\/ 开始扫描蓝牙设备","        RFIDBleManager.shared.scanForPeripherals { peripheral, advertisementData, RSSI in","            print(\"scanForPeripherals: \\(String(describing: peripheral.name))  \\(advertisementData.description)\")","","            \/\/ Filter by manufacturer data (requires BLE firmware 2.08+)","            \/\/ The prefix of kCBAdvDataManufacturerData is 0x4720","            \/\/ 通过厂家信息过滤设备（需要蓝牙固件 2.08+）","            \/\/ kCBAdvDataManufacturerData 前缀为 0x4720","            if let data = advertisementData[\"kCBAdvDataManufacturerData\"] as? Data,","               data.count >= 2 && data[0] == 0x47 && data[1] == 0x20","            {","                print(\"kCBAdvDataManufacturerData: \\(data)\")","            } else {","                \/\/ return  \/\/ Uncomment to filter out non-matching devices","                \/\/         \/\/ 取消注释以过滤不匹配的设备","            }","","            if !self.discoveredDevices.contains(where: { $0.name == peripheral.name }) {","                self.discoveredDevices.append(peripheral)","            }","        }","    }","","    func connectToDevice(_ peripheral: CBPeripheral) {","        RFIDBleManager.shared.connectPeripheral(","            peripheral: peripheral,","            didConnectBlock: { connectedPeripheral in","                print(\"Successfully connected: \\(connectedPeripheral.name ?? \"Unknown\")\")","            },","            didFailToConnectBlock: { failedPeripheral, error in","                print(\"Connection failed: \\(failedPeripheral.name ?? \"Unknown\") \" ","                    + \"Error: \\(error?.localizedDescription ?? \"Unknown error\")\"","                )","            }","        )","    }","}"],"highlights":[{"line":10},{"line":11},{"line":12},{"line":13}],"type":"file"},"doc://com.rfid.RFIDManager/tutorials/Meet-RFIDManager":{"role":"overview","abstract":[{"type":"text","text":"This tutorial will guide you through importing the RFIDManager library into your project and show you how to use it."}],"title":"Meet RFIDManager","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/Meet-RFIDManager","url":"\/tutorials\/meet-rfidmanager","type":"topic","kind":"overview"},"doc://com.rfid.RFIDManager/tutorials/RFIDManager/Getting-Started":{"abstract":[{"text":"This tutorial will guide you through the basic usage of RFIDManager SDK, including connecting devices and inventorying tags","type":"text"}],"url":"\/tutorials\/rfidmanager\/getting-started","identifier":"doc:\/\/com.rfid.RFIDManager\/tutorials\/RFIDManager\/Getting-Started","kind":"project","title":"Getting Started","estimatedTime":"20min","role":"project","type":"topic"},"inventory-tags-05.swift":{"fileName":"InventoryManager.swift","fileType":"swift","identifier":"inventory-tags-05.swift","syntax":"swift","content":["import Foundation","import RFIDManager","","class InventoryManager {","    func initInventory() {","        let res = RFIDBleManager.shared.initialize()","        print(\"initialize \\(res.code == .success ? \"success\" : \"failure\")\")","","        \/\/ Set tag data callback","        \/\/ 设置标签数据回调","        RFIDBleManager.shared.setTagInfoListBlock { tagList in","            print(\"Received \\(tagList.count) tags\")","            \/\/ Process tag data in callback","            \/\/ 可在回调中处理标签数据","            for tag in tagList {","                print(\"EPC: \\(tag.description)\")","            }","        }","    }","","    func startInventory() {","        let result = RFIDBleManager.shared.startInventory(filter: nil)","        print(result.code == .success ? \"Inventory started\" : \"\\(result.message ?? \"startInventory failed\")\")","    }","","    func stopInventory() {","        let result = RFIDBleManager.shared.stopInventory()","        print(result.code == .success ? \"Inventory stopped\" : \"\\(result.message ?? \"stopInventory failed\")\")","    }","","    func setConfig() {","        var res = RFIDBleManager.shared.setPower(20)","        print(res.code == .success ? \"setPower success\" : \"\\(res.message ?? \"setPower failed\")\")","","        res = RFIDBleManager.shared.setRFLink(RFIDRFLink.Gen2X_Miller8_160KHz.rawValue)","        print(res.code == .success ? \"setRFLinkMode success\" : \"\\(res.message ?? \"setRFLinkMode failed\")\")","","        res = RFIDBleManager.shared.setMemoryBank(RFIDMemoryBank(bank: RFIDMemoryBank.InventoryBank.EPC_TID.rawValue))","        print(res.code == .success ? \"setMemoryBank success\" : \"\\(res.message ?? \"setMemoryBank failed\")\")","    }","}"],"highlights":[{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38},{"line":39},{"line":40}],"type":"file"},"inventory-tags-00.swift":{"fileName":"InventoryManager.swift","fileType":"swift","identifier":"inventory-tags-00.swift","syntax":"swift","content":["import